# Template for .env (test mailbox credentials). Copy to .env and fill in.
# .env is gitignored and must never be committed.

MAILCLIENT_TEST_EMAIL=you@example.com
MAILCLIENT_TEST_IMAP_HOST=imap.example.com
MAILCLIENT_TEST_IMAP_PORT=993
MAILCLIENT_TEST_IMAP_SECURITY=tls
MAILCLIENT_TEST_IMAP_USER=you@example.com
MAILCLIENT_TEST_IMAP_PASS=your-app-password-here
MAILCLIENT_TEST_SMTP_HOST=smtp.example.com
MAILCLIENT_TEST_SMTP_PORT=465
MAILCLIENT_TEST_SMTP_SECURITY=tls
MAILCLIENT_TEST_SMTP_USER=you@example.com
MAILCLIENT_TEST_SMTP_PASS=your-app-password-here

# Optional scratch DB for sync experiments:
# MAILCLIENT_DB=/tmp/mailclient-test.sqlite

# Test-send safety (see sync::sender::SendPolicy).
# Set these to YOUR OWN test addresses locally; unset allowlist = deny all.
# MAILCLIENT_TEST_SEND_TO=
# MAILCLIENT_TEST_SEND_ALLOWLIST=
# MAILCLIENT_SEND_TEST_MAIL=1   # set to actually send (harness only)
# MAILCLIENT_ALLOW_ANY_RECIPIENT=1  # unlock real sending (production only)
