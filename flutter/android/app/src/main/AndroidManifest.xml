<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Runtime-prompted on API 33+ when background mail checks are enabled;
         install-time granted below that. No exact alarms, no foreground
         service: the checker is a plain WorkManager periodic task. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Lets Settings ask for the battery-optimisation exemption. Without
         it, Doze and App Standby defer the periodic worker by hours while
         the phone sleeps. Play restricts this permission; the APK is
         sideloaded. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Exact-alarm scheduler (Settings option, WorkManager stays default):
         the alarm fires on time in Doze via setExactAndAllowWhileIdle.
         Since Android 14 this is denied by default; Settings sends the user
         to the "Alarms & reminders" screen to allow it. Without the grant
         the alarm still fires via AllowWhileIdle, just not exact. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Needed by the alarm scheduler: WorkManager keeps the CPU awake for
         the short inbox check, and the alarm is re-armed after a reboot. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Cleartext is opt-in per account (plaintext IMAP/SMTP), not the
         default: every account uses TLS unless explicitly configured
         otherwise, which is why the global flag stays on. -->
    <application
        android:label="mailclient"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The mail reader's WebView must not phone home: Safe Browsing
             sends URL lookups and list updates to Google, and metrics upload
             usage. Mail content is already kept offline by the reader's CSP. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
        <!-- On-time background mail check (MailAlarm.kt): exact alarm shots,
             re-armed after a reboot or an app update. Only armed when
             Settings picks the alarm scheduler; otherwise it stays idle. -->
        <receiver
            android:name=".MailAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
