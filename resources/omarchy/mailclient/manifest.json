{
  "schemaVersion": 1,
  "id": "mailclient.unread",
  "name": "Mailclient unread",
  "version": "1.0.0",
  "author": "mailclient",
  "description": "Unread mail count from the mailclient app. Left-click opens mail, right-click syncs now.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Mailclient unread",
    "description": "Unread mail count; opens the mail app on click and notifies on new mail.",
    "category": "Mail",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "mailBin": "mailapp",
      "account": "",
      "syncIntervalMin": 15,
      "notify": true
    },
    "schema": [
      {
        "key": "mailBin",
        "type": "string",
        "label": "Mail binary (PATH lookup)",
        "defaultValue": "mailapp"
      },
      {
        "key": "account",
        "type": "string",
        "label": "Account filter: id or address (empty = all)",
        "defaultValue": ""
      },
      {
        "key": "syncIntervalMin",
        "type": "integer",
        "label": "Sync interval (minutes, mailapp --sync-once)",
        "min": 1,
        "max": 1440,
        "step": 1,
        "defaultValue": 15
      },
      {
        "key": "notify",
        "type": "boolean",
        "label": "Desktop notification on new mail",
        "defaultValue": true
      }
    ]
  }
}
