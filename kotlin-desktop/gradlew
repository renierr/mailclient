#!/bin/sh
# Minimal Gradle launcher for kotlin-desktop.
# Prefers (1) `gradle` on PATH, (2) a cached wrapper distribution
# (~/.gradle/wrapper/dists, e.g. from Android Studio), else prints help.
# Android Studio / IntelliJ import via gradle/wrapper/gradle-wrapper.properties.
set -eu
HERE="$(cd "$(dirname "$0")" && pwd)"

if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi

CANDIDATE="$(find "${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists" -path "*/bin/gradle" -type f 2>/dev/null | sort -r | head -n 1 || true)"
if [ -n "${CANDIDATE:-}" ]; then
  exec "$CANDIDATE" "$@"
fi

echo "No Gradle found. Install Gradle 9.x, or open kotlin-desktop/ in Android Studio." >&2
exit 1
