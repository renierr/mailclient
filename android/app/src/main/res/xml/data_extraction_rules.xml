<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ reads this file instead of backup_rules.xml (see the manifest's
     android:dataExtractionRules). Both sections are needed, and each defaults
     to "everything" when its section is missing, so an absent <device-transfer>
     would silently keep sending the mail cache device-to-device.

     The exclusions are the same as backup_rules.xml and for the same reasons;
     read that comment. Kept symmetric on purpose: adding or dropping a path in
     one section and not the other is exactly how a leak comes back. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="auth_vault.json" />
        <exclude domain="file" path="mailclient.sqlite" />
        <exclude domain="file" path="mailclient.sqlite-wal" />
        <exclude domain="file" path="mailclient.sqlite-shm" />
        <exclude domain="file" path="crashes" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="auth_vault.json" />
        <exclude domain="file" path="mailclient.sqlite" />
        <exclude domain="file" path="mailclient.sqlite-wal" />
        <exclude domain="file" path="mailclient.sqlite-shm" />
        <exclude domain="file" path="crashes" />
    </device-transfer>
</data-extraction-rules>
