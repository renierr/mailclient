# Same files on Linux and Windows: LF and UTF-8 whatever the editor's
# platform default. .gitattributes keeps git itself in line; this keeps
# editors from writing CRLF into a fresh file in the first place.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true

[*.{rs,qml,kts,kt}]
indent_style = space
indent_size = 4

[*.{dart,yaml,yml,json}]
indent_style = space
indent_size = 2
